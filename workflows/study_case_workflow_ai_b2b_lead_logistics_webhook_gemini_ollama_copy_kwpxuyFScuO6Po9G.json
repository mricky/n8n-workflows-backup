    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  let parsed = {\n    lead_score: 0,\n    category: \"COLD\",\n    urgency_level: \"Low\",\n    potential_value: \"Kecil\",\n    summary: \"-\",\n    sales_strategy: \"-\"\n  };\n\n  try {\n    // Ambil output teks dari AI (Gemini atau Ollama)\n    const rawText = item.json.text || item.json.response || \"\";\n    const cleanJson = rawText.replace(/```json|```/gi, '').trim();\n    parsed = JSON.parse(cleanJson);\n  } catch (err) {\n    parsed.summary = \"Gagal mem-parse respon AI ke JSON\";\n  }\n\n  // 1. Ambil data asli dari node Webhook\n  const webhookNode = $('Webhook').first().json;\n  const webhookData = webhookNode.body || webhookNode || {};\n\n  // 2. Cek AI engine yang memproses data\n  let aiProvider = \"Google Gemini\";\n  try {\n    if ($('LLM Ollama').all().length > 0) {\n      aiProvider = \"Local Ollama\";\n    }\n  } catch (e) {\n    aiProvider = \"Google Gemini\";\n  }\n\n  // 3. Bentuk output JSON bersih dan terstruktur\n  item.json = {\n    pic: webhookData.pic_name || \"-\",\n    perusahaan: webhookData.company_name || \"-\",\n    kontak: webhookData.contact || \"-\",\n    volume_armada: webhookData.volume_armada || \"-\",\n    rute_muatan: webhookData.rute_muatan || \"-\",\n    lead_score: Number(parsed.lead_score) || 0,\n    category: (parsed.category || \"COLD\").toUpperCase(),\n    urgency: parsed.urgency_level || \"Low\",\n    potential_value: parsed.potential_value || \"-\",\n    summary: parsed.summary || \"-\",\n    sales_strategy: parsed.sales_strategy || \"-\",\n    ai_engine: aiProvider,\n    waktu_masuk: new Date().toLocaleString(\"id-ID\", { timeZone: \"Asia/Jakarta\" })\n  };\n}\n\nreturn $input.all();\n"
      },
