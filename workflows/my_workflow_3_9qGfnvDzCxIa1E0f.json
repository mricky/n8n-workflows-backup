    {
      "parameters": {
        "jsCode": "const targetKeywords = ['staff', 'principal', 'lead', 'backend', 'architect', 'ai', 'engineer', 'senior'];\nconst seenHashes = new Set();\nconst output = [];\n\nfunction addJob(company, position, url, location, salary, desc) {\n  if (!company || !position) return;\n  const titleLower = position.toLowerCase();\n  \n  if (targetKeywords.some(k => titleLower.includes(k))) {\n    const cleanComp = company.toLowerCase().replace(/[^a-z0-9]/g, '');\n    const cleanPos = titleLower.replace(/[^a-z0-9]/g, '');\n    const idHash = `${cleanComp}_${cleanPos}`;\n\n    if (!seenHashes.has(idHash)) {\n      seenHashes.add(idHash);\n      output.push({\n        json: {\n          id_hash: idHash,\n          company: company.trim(),\n          position: position.trim(),\n          url: url || '',\n          company_url: `https://${cleanComp}.com`,\n          location: location || 'Remote (Worldwide)',\n          salary: salary || 'Not Disclosed',\n          description: desc ? desc.substring(0, 1500) : position\n        }\n      });\n    }\n  }\n}\n\nfor (const item of $input.all()) {\n  const d = item.json;\n  if (!d) continue;\n\n  // 1. Format RemoteOK\n  if (d.slug && d.position) {\n    const sal = (d.salary_min && d.salary_max) ? `$${d.salary_min} - $${d.salary_max}` : 'Not Disclosed';\n    addJob(d.company, d.position, d.url || `https://remoteok.com/remote-jobs/${d.slug}`, d.location, sal, d.description);\n  }\n  // 2. Format RSS (WeWorkRemotely, Himalayas, NoDesk)\n  else if (d.title && (d.link || d.guid)) {\n    let company = 'Tech Company';\n    let role = d.title;\n    if (d.title.includes(':')) {\n      const parts = d.title.split(':');\n      company = parts[0].trim();\n      role = parts.slice(1).join(':').trim();\n    } else if (d.title.includes(' at ')) {\n      const parts = d.title.split(' at ');\n      role = parts[0].trim();\n      company = parts[1].trim();\n    }\n    addJob(company, role, d.link || d.guid, d.region || 'Worldwide', 'Not Disclosed', d.contentSnippet || d.content);\n  }\n  // 3. Format Remotive & Arbeitnow (Array Jobs / Data)\n  else if (d.jobs && Array.isArray(d.jobs)) {\n    for (const job of d.jobs) {\n      addJob(job.company_name, job.title, job.url, job.candidate_required_location, job.salary || 'Not Disclosed', job.description);\n    }\n  }\n  else if (d.data && Array.isArray(d.data)) {\n    for (const job of d.data) {\n      addJob(job.company_name, job.title, job.url, job.location, 'Not Disclosed', job.description);\n    }\n  }\n}\n\n// Batasi 5 lowongan teratas per run agar aman di kuota AI\nreturn output.slice(0, 10);\n"
      },
