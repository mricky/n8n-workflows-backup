    {
      "parameters": {
        "jsCode": "const output = [];\nlet originalJobs = [];\ntry {\n  originalJobs = $('Consolidate, Filter & Hash').all();\n} catch (e) {\n  originalJobs = [];\n}\n\nconst items = $input.all();\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  let aiData = {};\n  \n  // Ekstrak HANYA blok JSON { ... } secara otomatis\n  try {\n    const rawText = item.json.text || '';\n    const jsonMatch = rawText.match(/\\{[\\s\\S]*\\}/);\n    if (jsonMatch) {\n      aiData = JSON.parse(jsonMatch[0]);\n    }\n  } catch (e) {\n    aiData = {};\n  }\n\n  const orig = originalJobs[i] ? originalJobs[i].json : (item.json || {});\n\n  output.push({\n    json: {\n      id_hash: orig.id_hash || 'job_hash',\n      tanggal_ditemukan: new Date().toISOString().split('T')[0],\n      perusahaan: orig.company || 'Tech Company',\n      posisi: orig.position || 'Software Engineer',\n      company_url: aiData.company_url || orig.company_url || '',\n      hiring_manager: aiData.hiring_manager || 'Not Mentioned',\n      work_model: aiData.work_model || '100% Remote (WFH)',\n      estimasi_gaji: aiData.estimated_salary || orig.salary || 'Not Disclosed',\n      timezone_policy: aiData.timezone || orig.location || 'Worldwide',\n      match_score: aiData.match_score || '85%',\n      url_lowongan: orig.url || '',\n      pitch_cover_note: aiData.pitch_cover_note || '',\n      linkedin_dm_script: aiData.linkedin_dm_script || '',\n      status: 'TO_APPLY',\n      tanggal_apply: '',\n      catatan: ''\n    }\n  });\n}\n\nreturn output;\n"
      },
