{
  "name": "Workflow 12: Automated GitHub Backup Pipeline",
  "nodes": [
    {
      "parameters": {},
      "id": "7a8b9c0d-1e2f-3a4b-5c6d-7e8f9a0b1c2d",
      "name": "Manual Test Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        240
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 0
            }
          ]
        }
      },
      "id": "8b9c0d1e-2f3a-4b5c-6d7e-8f9a0b1c2d3e",
      "name": "Daily Midnight Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        420
      ]
    },
    {
      "parameters": {
        "url": "http://localhost:5678/api/v1/workflows",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-API-KEY",
              "value": "***REDACTED_N8N_API_KEY***"
            }
          ]
        },
        "options": {}
      },
      "id": "9c0d1e2f-3a4b-5c6d-7e8f-9a0b1c2d3e4f",
      "name": "Fetch All Workflows (n8n API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        340
      ]
    },
    {
      "parameters": {
        "jsCode": "const workflows = $input.first().json.data || [];\nconst results = [];\n\nfor (const wf of workflows) {\n  const safeName = (wf.name || 'workflow')\n    .toLowerCase()\n    .replace(/[^a-z0-9]/g, '_')\n    .replace(/_+/g, '_')\n    .replace(/^_|_$/g, '');\n  \n  const filePath = `workflows/${safeName}_${wf.id}.json`;\n\n  // Sanitasi kredensial rahasia agar lolos proteksi GitHub Secret Scanning\n  let rawString = JSON.stringify(wf, null, 2);\n  rawString = rawString.replace(/ghp_[a-zA-Z0-9]{30,}/g, '***REDACTED_GITHUB_TOKEN***');\n  rawString = rawString.replace(/eyJhbGciOiJIUzI1Ni[a-zA-Z0-9_\\-\\.]+/g, '***REDACTED_N8N_API_KEY***');\n\n  const base64Content = Buffer.from(rawString).toString('base64');\n\n  results.push({\n    json: {\n      id: wf.id,\n      name: wf.name,\n      active: wf.active,\n      filePath: filePath,\n      base64Content: base64Content,\n      updatedAt: wf.updatedAt\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "0d1e2f3a-4b5c-6d7e-8f9a-0b1c2d3e4f5a",
      "name": "Prepare Workflows for GitHub",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        340
      ]
    },
    {
      "parameters": {
        "url": "=https://api.github.com/repos/mricky/n8n-workflows-backup/contents/{{ $json.filePath }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer ***REDACTED_GITHUB_TOKEN***"
            },
            {
              "name": "User-Agent",
              "value": "n8n-backup-bot"
            }
          ]
        },
        "options": {}
      },
      "id": "1e2f3a4b-5c6d-7e8f-9a0b-1c2d3e4f5a6b",
      "name": "Check Existing File on GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        340
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst originalItems = $('Prepare Workflows for GitHub').all();\nconst results = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const current = items[i].json;\n  const original = originalItems[i].json;\n  const sha = current && current.sha ? current.sha : null;\n  const existingContent = current && current.content ? current.content.replace(/\\s+/g, '') : '';\n  const newContent = original.base64Content.replace(/\\s+/g, '');\n\n  // Hanya push jika file baru atau isi workflow mengalami perubahan\n  const isIdentical = Boolean(sha && existingContent === newContent);\n\n  if (!isIdentical) {\n    const payload = {\n      message: 'Backup: ' + original.name + ' (' + (sha ? 'update' : 'create') + ') [skip ci]',\n      content: original.base64Content\n    };\n    if (sha) {\n      payload.sha = sha;\n    }\n\n    results.push({\n      json: {\n        id: original.id,\n        workflowName: original.name,\n        filePath: original.filePath,\n        githubPayload: payload\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "id": "2f3a4b5c-6d7e-8f9a-0b1c-2d3e4f5a6b7c",
      "name": "Merge SHA for Commit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        340
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://api.github.com/repos/mricky/n8n-workflows-backup/contents/{{ $json.filePath }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer ***REDACTED_GITHUB_TOKEN***"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "User-Agent",
              "value": "n8n-backup-bot"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.githubPayload }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1200
            }
          }
        }
      },
      "id": "3a4b5c6d-7e8f-9a0b-1c2d-3e4f5a6b7c8d",
      "name": "Push JSON to GitHub Repo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        340
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst total = items.length;\nconst timestamp = new Date().toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' });\n\nreturn [{\n  json: {\n    status: \"success\",\n    total_workflows_backed_up: total,\n    repository: \"mricky/n8n-workflows-backup\",\n    last_synced: timestamp,\n    message: `✅ Berhasil mencadangkan ${total} workflows n8n ke GitHub!`\n  }\n}];"
      },
      "id": "4b5c6d7e-8f9a-0b1c-2d3e-4f5a6b7c8d9e",
      "name": "Generate Backup Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        340
      ]
    }
  ],
  "connections": {
    "Manual Test Trigger": {
      "main": [
        [
          {
            "node": "Fetch All Workflows (n8n API)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily Midnight Trigger": {
      "main": [
        [
          {
            "node": "Fetch All Workflows (n8n API)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch All Workflows (n8n API)": {
      "main": [
        [
          {
            "node": "Prepare Workflows for GitHub",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Workflows for GitHub": {
      "main": [
        [
          {
            "node": "Check Existing File on GitHub",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Existing File on GitHub": {
      "main": [
        [
          {
            "node": "Merge SHA for Commit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Merge SHA for Commit": {
      "main": [
        [
          {
            "node": "Push JSON to GitHub Repo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Push JSON to GitHub Repo": {
      "main": [
        [
          {
            "node": "Generate Backup Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
