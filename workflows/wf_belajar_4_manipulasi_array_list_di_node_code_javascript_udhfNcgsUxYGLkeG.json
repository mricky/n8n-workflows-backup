      "parameters": {
        "jsCode": "const rawOrders = [\n  { id: 101, customer: \"Ricky\", category: \"VIP\", items: [\"Laptop\", \"Mouse\"], total: 15000000 },\n  { id: 102, customer: \"Budi\", category: \"REGULER\", items: [\"Keyboard\"], total: 450000 },\n  { id: 103, customer: \"Siti\", category: \"KOMPLAIN_URGENT\", items: [\"Monitor Rusak\"], total: 3200000 }\n];\n\n// Kita manipulasi: Filter, beri diskon, & format ke struktur n8n\nconst result = [];\nfor (const order of rawOrders) {\n  // Hitung diskon khusus VIP\n  let discount = 0;\n  if (order.category === \"VIP\") {\n    discount = order.total * 0.10; // Diskon 10%\n  }\n  \n  // Format menjadi objek n8n\n  result.push({\n    json: {\n      order_id: order.id,\n      customer_name: order.customer.toUpperCase(),\n      category: order.category,\n      total_items: order.items.length,\n      original_total: order.total,\n      discount_amount: discount,\n      final_total: order.total - discount,\n      processed_at: new Date().toISOString()\n    }\n  });\n}\n// Mengembalikan 3 item baris terpisah di n8n\nreturn result;\n"
      },
