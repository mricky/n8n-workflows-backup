    {
      "parameters": {
        "jsCode": "// 1. Ambil data asli baris dari \"Get row(s) in sheet\"\nconst sheetItem = $('Get row(s) in sheet').first().json;\n\n// 2. Ambil ID hasil publish (Facebook & Instagram)\nlet fbPostId = 'N/A';\nlet igPostId = 'N/A';\n\ntry {\n  fbPostId = $('HTTP Facebook').first().json.id || 'N/A';\n} catch (e) {}\n\ntry {\n  igPostId = $('Publish IG Media').first().json.id || 'N/A';\n} catch (e) {}\n\n// 3. Format waktu WIB\nconst waktuTayang = new Date().toLocaleString(\"id-ID\", { \n  timeZone: \"Asia/Jakarta\" \n});\n\n// 4. Return data bersih khusus untuk Google Sheets\nreturn [\n  {\n    json: {\n      id: sheetItem.id,\n      status: \"POSTED\",\n      Status: \"POSTED\", // cadangan jika header sheet Anda huruf kapital 'Status'\n      tanggal_tayang: waktuTayang,\n      log_info: `Konten #${sheetItem.id} sukses tayang! FB: ${fbPostId}, IG: ${igPostId}`\n    }\n  }\n];\n"
      },
