    {
      "parameters": {
        "jsCode": "// 1. Ambil seluruh data baris dari Google Sheets\nconst items = $input.all();\n\n// 2. Filter baris yang kolom Status-nya 'READY'\nconst pending = items.filter(item => {\n  const status = item.json['Status'] || item.json['status'] || '';\n  return status.toString().trim().toUpperCase() === 'READY';\n});\n\n// 3. Jika tidak ada baris READY, berhenti aman\nif (pending.length === 0) {\n  return [];\n}\n\n// 4. Ambil 1 baris teratas yang READY\nconst target = pending[0].json;\n\n// 5. Ambil nama file MP4 di Drive\nconst filename = (target['Video Filename'] || target['video_file_name'] || target['Filename'] || '').trim();\n\n// 6. Siapkan Judul dengan hashtag #Shorts\nlet title = target['YouTube Title'] || target['youtube_title'] || target['Title'] || 'Otomasi Cerdas dengan n8n';\nif (!title.toLowerCase().includes('#shorts')) {\n  title = `${title} #Shorts`;\n}\n\n// 7. Siapkan Deskripsi & Tags\nconst defaultDescription = `Dari proses manual berhari-hari, dipangkas jadi hitungan detik menggunakan n8n & modern web ERP! ⚡\\n\\n📌 Fitur yang didemokan:\\n- Realtime multi-bank transaction ingestion\\n- 3-Way Auto-Match kliring instan\\n- Split matching & quick adjustment journal\\n- Export Berita Acara Rekonsiliasi resmi format PDF\\n\\n🎥 Tutorial arsitektur lengkapnya tonton di channel YouTube: @mrickyit\\n\\n#Shorts #n8n #ERP #AccountingAutomation #Fintech #Nextjs #Supabase`;\n\nconst description = target['Description'] || target['description'] || defaultDescription;\nconst rawTags = target['Tags'] || target['tags'] || '';\nconst tags = rawTags \n  ? rawTags.split(',').map(t => t.trim()) \n  : ['Shorts', 'n8n', 'ERP', 'Accounting', 'Fintech', 'Nextjs', 'Supabase', 'Automation', 'Ricky'];\n\n// 8. Kirim 1 item data siap pakai ke node selanjutnya\nreturn [{\n  json: {\n    video_file_name: filename,\n    title: title,\n    description: description,\n    tags: tags\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
